# ── Capture ──────────────────────────────────────────────────────────────────
CAPTURE_TARGET_FPS=10
CAPTURE_CAPTURE_WIDTH=1920
CAPTURE_CAPTURE_HEIGHT=1080
CAPTURE_GAME_WINDOW_TITLE=VALORANT

# ── JPEG quality (10-100) ────────────────────────────────────────────────────
CAPTURE_JPEG_QUALITY=75

# ── WebSocket server ─────────────────────────────────────────────────────────
CAPTURE_WS_HOST=0.0.0.0
CAPTURE_WS_PORT=8000

# ── Queue ────────────────────────────────────────────────────────────────────
CAPTURE_MAX_QUEUE_SIZE=5

# ── Debug / benchmark ────────────────────────────────────────────────────────
CAPTURE_DEBUG_MODE=false
CAPTURE_FRAME_SAVE_INTERVAL=5.0
CAPTURE_FRAME_SAVE_DIR=debug_frames
CAPTURE_BENCHMARK_MODE=false
CAPTURE_BENCHMARK_LOG_INTERVAL=5.0

# ── Vision service ────────────────────────────────────────────────────────────
VISION_CAPTURE_WS_URL=ws://localhost:8000/stream
VISION_WS_PORT=8100
VISION_ANALYSIS_FPS=5
VISION_OCR_GPU=false
VISION_DEBUG_MODE=false
VISION_BENCHMARK_MODE=false

# ── Event service ─────────────────────────────────────────────────────────────
EVENT_VISION_EVENTS_URL=ws://localhost:8100/events
EVENT_VISION_STATE_URL=ws://localhost:8100/game-state
EVENT_WS_PORT=8200
# SQLite (default — no setup needed):
EVENT_DATABASE_URL=sqlite+aiosqlite:///./valorant_memory.db
# PostgreSQL (production):
# EVENT_DATABASE_URL=postgresql+asyncpg://user:pass@localhost/valorant_coach
# Redis (optional — leave empty to use in-memory fallback):
EVENT_REDIS_URL=
EVENT_DEBUG_MODE=false
EVENT_BENCHMARK_MODE=false
# ── Thresholds ────────────────────────────────────────────────────────────────
EVENT_FORCE_BUY_CREDITS_THRESHOLD=2900
EVENT_ECO_ROUND_THRESHOLD=1900
EVENT_LOW_HEALTH_PEEK_THRESHOLD=35
EVENT_EARLY_ROUND_THRESHOLD_S=45.0
EVENT_PATTERN_WINDOW_ROUNDS=5
EVENT_PATTERN_MIN_OCCURRENCES=2
