# ── Capture ──────────────────────────────────────────────────────────────────
CAPTURE_TARGET_FPS=10
CAPTURE_CAPTURE_WIDTH=1920
CAPTURE_CAPTURE_HEIGHT=1080
CAPTURE_GAME_WINDOW_TITLE=VALORANT

# ── JPEG quality (10-100) ────────────────────────────────────────────────────
CAPTURE_JPEG_QUALITY=75

# ── WebSocket server ─────────────────────────────────────────────────────────
CAPTURE_WS_HOST=0.0.0.0
CAPTURE_WS_PORT=8000

# ── Queue ────────────────────────────────────────────────────────────────────
CAPTURE_MAX_QUEUE_SIZE=5

# ── Debug / benchmark ────────────────────────────────────────────────────────
CAPTURE_DEBUG_MODE=false
CAPTURE_FRAME_SAVE_INTERVAL=5.0
CAPTURE_FRAME_SAVE_DIR=debug_frames
CAPTURE_BENCHMARK_MODE=false
CAPTURE_BENCHMARK_LOG_INTERVAL=5.0
